#!/usr/bin/env bash
# Add one or more MCP servers to Claude Code by name
# Usage: mcpadd [--scope SCOPE] NAME [NAME2 NAME3 ...]
#
# For servers that require a local clone, set MCP_SRC_DIR (default: $HOME/src)

set -euo pipefail

SCOPE="local"
if [[ "${1:-}" == "--scope" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "Error: --scope requires an argument" >&2
    exit 1
  fi
  SCOPE="$2"
  shift 2
fi

if [ "$#" -lt 1 ]; then
  echo "Usage: mcpadd [--scope SCOPE] NAME [NAME ...]" >&2
  exit 1
fi

SRC_DIR="${MCP_SRC_DIR:-$HOME/src}"

# Clone a repo and build with npm if not already present
ensure_npm_clone() {
  local repo_url="$1"
  local dir="$2"
  if [ ! -d "$dir" ]; then
    echo "Cloning $repo_url into $dir..."
    git clone "$repo_url" "$dir"
    (cd "$dir" && npm install && npm run build)
  fi
}

_append_env_var() {
  local key="$1" default_val="$2"
  local val="${!key:-$default_val}"
  if grep -qE "^${key}=" .env 2>/dev/null; then
    if [ -z "${!key:-}" ]; then
      val=$(grep -E "^${key}=" .env 2>/dev/null | cut -d= -f2-)
      export "${key}=${val}"
    fi
    return 0
  fi
  echo "${key}=${val}" >> .env
  echo "  Added ${key}=${val} to .env"
}

PLUGIN_MARKETPLACE="${PLUGIN_MARKETPLACE:-claude-plugins-official}"

# LSP plugins are Claude Code plugins (not MCP servers) that wrap a local language-server binary
_install_lsp_plugin() {
  local plugin="$1" binary="$2"
  if ! command -v "$binary" &>/dev/null; then
    echo "Error: $binary not found on PATH — $plugin needs it" >&2
    return 1
  fi
  claude plugin install "${plugin}@${PLUGIN_MARKETPLACE}" -s "$SCOPE"
}

add_one() {
  local NAME="$1"
  case "$NAME" in
    Context7)
      claude mcp add -s "$SCOPE" Context7 -- npx -y @upstash/context7-mcp@latest
      ;;
    sequential-thinking)
      claude mcp add -s "$SCOPE" sequential-thinking -- npx -y @modelcontextprotocol/server-sequential-thinking
      ;;
    foundry-mcp-server)
      claude mcp add -s "$SCOPE" foundry-mcp-server -- npx -y @pranesh.asp/foundry-mcp-server
      ;;
    code-index)
      claude mcp add -s "$SCOPE" code-index -- uvx code-index-mcp
      ;;
    rust-docs)
      local dir="$SRC_DIR/rust-docs-mcp-server"
      ensure_npm_clone "https://github.com/Govcraft/rust-docs-mcp-server" "$dir"
      claude mcp add -s "$SCOPE" rust-docs -- node "$dir/build/index.js"
      ;;
    basic-memory)
      claude mcp add -s "$SCOPE" basic-memory -- basic-memory mcp
      ;;
    fetch)
      claude mcp add -s "$SCOPE" fetch -- uvx mcp-server-fetch
      ;;
    pdf-reader)
      claude mcp add -s "$SCOPE" pdf-reader -- uvx mcp-read-pdf
      ;;
    xcode)
      local dir="$SRC_DIR/xcode-mcp-server"
      ensure_npm_clone "https://github.com/r-huijts/xcode-mcp-server" "$dir"
      claude mcp add -s "$SCOPE" xcode -- node "$dir/dist/index.js"
      ;;
    perplexity-ask)
      if [ -z "${PERPLEXITY_API_KEY:-}" ]; then
        echo "Error: PERPLEXITY_API_KEY not set." >&2
        return 1
      fi
      claude mcp add -s "$SCOPE" perplexity-ask \
        --env PERPLEXITY_API_KEY="$PERPLEXITY_API_KEY" \
        -- npx -y server-perplexity-ask
      ;;
    calculator)
      claude mcp add -s "$SCOPE" calculator -- uvx mcp-server-calculator
      ;;
    playwright)
      claude mcp add -s "$SCOPE" playwright -- npx -y @executeautomation/playwright-mcp-server
      ;;
    n8n)
      : "${N8N_API_URL:=http://localhost:5678/api/v1}"
      if [ -z "${N8N_API_KEY:-}" ]; then
        echo "Error: N8N_API_KEY not set." >&2
        return 1
      fi
      claude mcp add -s "$SCOPE" n8n \
        --env N8N_API_URL="$N8N_API_URL" \
        --env N8N_API_KEY="$N8N_API_KEY" \
        -- npx -y n8n-mcp-server
      ;;
    brave-search)
      if [ -z "${BRAVE_API_KEY:-}" ]; then
        echo "Error: BRAVE_API_KEY not set." >&2
        return 1
      fi
      claude mcp add -s "$SCOPE" brave-search \
        --env BRAVE_API_KEY="$BRAVE_API_KEY" \
        -- npx -y @modelcontextprotocol/server-brave-search
      ;;
    mindmap)
      claude mcp add -s "$SCOPE" mindmap -- uvx mindmap-mcp-server --return-type html
      ;;
    puppeteer)
      local default_puppeteer_args='{"headless":false}'
      : "${PUPPETEER_ARGS:=$default_puppeteer_args}"
      claude mcp add -s "$SCOPE" puppeteer \
        --env "PUPPETEER_ARGS=${PUPPETEER_ARGS}" \
        -- npx -y github:afshawnlotfi/mcp-configurable-puppeteer
      ;;
    task-master-ai)
      : "${MODEL:=claude-sonnet-4-20250514}"
      : "${PERPLEXITY_MODEL:=sonar-pro}"
      : "${MAX_TOKENS:=64000}"
      : "${TEMPERATURE:=0.2}"
      : "${DEFAULT_SUBTASKS:=5}"
      : "${DEFAULT_PRIORITY:=medium}"
      claude mcp add -s "$SCOPE" task-master-ai \
        --env MODEL="$MODEL" \
        --env PERPLEXITY_MODEL="$PERPLEXITY_MODEL" \
        --env MAX_TOKENS="$MAX_TOKENS" \
        --env TEMPERATURE="$TEMPERATURE" \
        --env DEFAULT_SUBTASKS="$DEFAULT_SUBTASKS" \
        --env DEFAULT_PRIORITY="$DEFAULT_PRIORITY" \
        -- npx -y --package=task-master-ai task-master-ai
      ;;
    tree-sitter-mcp)
      claude mcp add-json -s "$SCOPE" tree-sitter-mcp \
        "{\"command\": \"sh\", \"args\": [\"-c\", \"cd \\\"$(pwd)\\\" && npx @nendo/tree-sitter-mcp --mcp\"]}"
      ;;
    iterm-mcp)
      claude mcp add -s "$SCOPE" iterm-mcp -- npx -y iterm-mcp
      ;;
    crypto-market-data)
      claude mcp add-json -s "$SCOPE" crypto-market-data \
        '{"type":"http","url":"https://mcp.crypto.com/market-data/mcp"}'
      ;;
    obsidian)
      : "${OBSIDIAN_HOST:=127.0.0.1}"
      : "${OBSIDIAN_PORT:=27124}"
      _append_env_var OBSIDIAN_API_KEY "${OBSIDIAN_API_KEY:-}"
      _append_env_var OBSIDIAN_HOST "$OBSIDIAN_HOST"
      _append_env_var OBSIDIAN_PORT "$OBSIDIAN_PORT"
      if [ -z "${OBSIDIAN_API_KEY:-}" ]; then
        echo "Error: OBSIDIAN_API_KEY is not set." >&2
        echo "  Install the 'Local REST API' community plugin in Obsidian," >&2
        echo "  copy the API key from its settings, add it to .env, then re-run." >&2
        return 1
      fi
      claude mcp add -s "$SCOPE" obsidian \
        --env OBSIDIAN_API_KEY="$OBSIDIAN_API_KEY" \
        --env OBSIDIAN_HOST="$OBSIDIAN_HOST" \
        --env OBSIDIAN_PORT="$OBSIDIAN_PORT" \
        -- uvx mcp-obsidian
      ;;
    neo4j-cypher)
      : "${NEO4J_URI:=bolt://localhost:7687}"
      : "${NEO4J_USERNAME:=neo4j}"
      : "${NEO4J_PASSWORD:=neo4j}"
      : "${NEO4J_DATABASE:=neo4j}"
      _append_env_var NEO4J_URI "$NEO4J_URI"
      _append_env_var NEO4J_USERNAME "$NEO4J_USERNAME"
      _append_env_var NEO4J_PASSWORD "$NEO4J_PASSWORD"
      _append_env_var NEO4J_DATABASE "$NEO4J_DATABASE"
      claude mcp add -s "$SCOPE" neo4j-cypher \
        --env NEO4J_URI="$NEO4J_URI" \
        --env NEO4J_USERNAME="$NEO4J_USERNAME" \
        --env NEO4J_PASSWORD="$NEO4J_PASSWORD" \
        --env NEO4J_DATABASE="$NEO4J_DATABASE" \
        -- uvx mcp-neo4j-cypher
      ;;
    repowise)
      # repowise is ALWAYS project scope — shared via .mcp.json, never user/global
      if [[ "$SCOPE" != "project" ]]; then
        echo "Note: repowise is always added at project scope (ignoring --scope $SCOPE)"
      fi
      if ! command -v repowise &>/dev/null; then
        echo "repowise not found — installing via uv..."
        if ! uv tool install repowise; then
          echo "Error: failed to install repowise" >&2
          return 1
        fi
      fi
      if [ ! -d "$(pwd)/.repowise" ]; then
        echo "No .repowise index found — running repowise init (~25 min, ~\$50 in LLM API costs)..."
        if ! repowise init "$(pwd)"; then
          echo "Error: repowise init failed" >&2
          return 1
        fi
      fi
      local out
      if ! out=$(claude mcp add-json -s project repowise \
        "{\"command\": \"repowise\", \"args\": [\"mcp\", \"$(pwd)\", \"--transport\", \"stdio\"], \"description\": \"repowise: codebase intelligence — docs, graph, git signals, dead code, decisions\"}" 2>&1); then
        if echo "$out" | grep -qi "already exists"; then
          echo "repowise already configured in .mcp.json"
        else
          echo "$out" >&2
          return 1
        fi
      else
        echo "$out"
      fi
      ;;
    cerebra-legal)
      # project/local scope only — never user or global
      if [[ "$SCOPE" == "user" || "$SCOPE" == "global" ]]; then
        echo "Error: cerebra-legal must be at project or local scope, not $SCOPE" >&2
        return 1
      fi
      local dir="$SRC_DIR/mcp-cerebra-legal-server"
      ensure_npm_clone "https://github.com/yoda-digital/mcp-cerebra-legal-server" "$dir"
      claude mcp add -s "$SCOPE" cerebra-legal -- node "$dir/build/index.js"
      ;;
    us-legal)
      # project/local scope only — never user or global
      if [[ "$SCOPE" == "user" || "$SCOPE" == "global" ]]; then
        echo "Error: us-legal must be at project or local scope, not $SCOPE" >&2
        return 1
      fi
      if [ -z "${CONGRESS_API_KEY:-}" ]; then
        echo "Warning: CONGRESS_API_KEY not set — Congress.gov search will not work" >&2
      fi
      if [ -z "${COURT_LISTENER_API_KEY:-}" ]; then
        echo "Warning: COURT_LISTENER_API_KEY not set — CourtListener search will not work" >&2
      fi
      claude mcp add -s "$SCOPE" us-legal \
        --env CONGRESS_API_KEY="${CONGRESS_API_KEY:-}" \
        --env COURT_LISTENER_API_KEY="${COURT_LISTENER_API_KEY:-}" \
        -- npx -y us-legal-mcp
      ;;
    rust-analyzer-lsp)
      _install_lsp_plugin rust-analyzer-lsp rust-analyzer
      ;;
    clangd-lsp)
      _install_lsp_plugin clangd-lsp clangd
      ;;
    *)
      echo "Unknown MCP server: $NAME" >&2
      return 2
      ;;
  esac
}

status=0
for NAME in "$@"; do
  echo "→ Adding: $NAME (scope=$SCOPE)"
  if ! add_one "$NAME"; then
    echo "✗ Failed: $NAME" >&2
    status=1
  else
    echo "✓ Added:  $NAME"
  fi
done

exit $status
